APP_NAME=BasDrive
APP_ENV=development
SECRET_KEY=ganti-secret-basdrive-produksi
ACCESS_TOKEN_MINUTES=480
REFRESH_TOKEN_DAYS=30

DATABASE_URL=sqlite:///./basdrive.db
STORAGE_PATH=./storage
MAX_UPLOAD_MB=2048
DEFAULT_QUOTA_GB=10

ALLOW_REGISTER=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@basdrive.local
ADMIN_PASSWORD=Admin@12345

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# LDAP / Active Directory (Exchange-compatible directory)
LDAP_ENABLED=false
LDAP_SERVER=ldap://dc.company.local
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_START_TLS=false
LDAP_BIND_DN=CN=basdrive,OU=Service Accounts,DC=company,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=company,DC=local
LDAP_DOMAIN=company.local
LDAP_USER_FILTER=(|(sAMAccountName={username})(userPrincipalName={username})(uid={username}))
LDAP_EMAIL_ATTR=mail
LDAP_NAME_ATTR=displayName
LDAP_TIMEOUT=8
